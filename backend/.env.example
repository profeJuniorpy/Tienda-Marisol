# ─── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# En producción: URL de Netlify + localhost separados por coma
FRONTEND_URL=https://tu-app.netlify.app,http://localhost:5173

# ─── Base de datos ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marisol_db
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_DIALECT=mysql

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar_por_clave_segura_de_64_caracteres_minimo
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=cambiar_por_otra_clave_segura_diferente
JWT_REFRESH_EXPIRES_IN=30d
JWT_CLIENTE_EXPIRES_IN=30d

# ─── SIFEN (SET Paraguay) ──────────────────────────────────────────────────
SIFEN_AMBIENTE=test
SIFEN_RUC=80000000-1
SIFEN_NOMBRE=TIENDA MARISOL
SIFEN_DIRECCION=MERCADO NRO 1, LOCAL X, CORONEL OVIEDO
SIFEN_CERTIFICADO_PATH=./certs/firma_digital.pfx
SIFEN_CERTIFICADO_PASSWORD=

# ─── Cloudinary (imágenes) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=marisol.tienda@gmail.com
EMAIL_PASS=app_password_gmail
EMAIL_FROM="Tienda Marisol <marisol.tienda@gmail.com>"

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
