# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=production
FRONTEND_URL=https://tu-app.netlify.app

# ─── Base de datos (Filess.io) ───────────────────────────────────────────────
DB_HOST=PEGAR_HOST_DE_FILESS
DB_PORT=PEGAR_PORT_DE_FILESS
DB_NAME=marisol_db
DB_USER=PEGAR_USER_DE_FILESS
DB_PASSWORD=PEGAR_PASSWORD_DE_FILESS

# ─── Admin inicial (se crea automáticamente en primer arranque) ──────────────
ADMIN_EMAIL=admin@marisol.com
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=Admin2026!

# ─── JWT (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=GENERAR_CLAVE_ALEATORIA_64_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GENERAR_OTRA_CLAVE_DIFERENTE_64_CHARS
JWT_REFRESH_EXPIRES_IN=30d
JWT_CLIENTE_EXPIRES_IN=30d

# ─── SIFEN (SET Paraguay) ────────────────────────────────────────────────────
SIFEN_AMBIENTE=test
SIFEN_RUC=80000000-1
SIFEN_NOMBRE=TIENDA MARISOL
SIFEN_DIRECCION=MERCADO NRO 1, LOCAL 15, CORONEL OVIEDO

# ─── Email (opcional para envío de códigos de retiro) ────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Tienda Marisol <marisol.tienda@gmail.com>

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
